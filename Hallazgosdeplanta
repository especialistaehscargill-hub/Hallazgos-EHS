    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const styles = {
        success: 'bg-[#005A2B] text-white border-emerald-400',
        error: 'bg-red-700 text-white border-red-400',
        info: 'bg-slate-800 text-white border-slate-600'
      };
      toast.className = `pointer-events-auto px-4 py-3 rounded-2xl shadow-xl border text-xs sm:text-sm font-semibold flex items-center justify-between gap-3 transition transform duration-300 ${styles[type] || styles.info}`;
      toast.innerHTML = `<span>${message}</span>`;
      container.appendChild(toast);
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-x-4');
        setTimeout(() => toast.remove(), 300);
      }, 4200);
    }

    /**
     * COMPRESIÓN DE IMÁGENES CON <canvas>
     */
    function compressImageToDataUrl(file, maxWidth = 800, quality = 0.72) {
      return new Promise((resolve, reject) => {
        if (!file) {
          resolve('');
          return;
        }
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            const canvas = document.createElement('canvas');
            let width = img.width;
            let height = img.height;
            if (width > maxWidth) {
              height = Math.round((height * maxWidth) / width);
              width = maxWidth;
            }
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);
            resolve(canvas.toDataURL('image/jpeg', quality));
          };
          img.onerror = reject;
          img.src = e.target.result;
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    /**
     * NOTIFICACIÓN POR CORREO EXCLUSIVAMENTE AL RESPONSABLE
     */
    function notifyResponsibleByEmail(finding, eventType) {
      const subject = eventType === 'REGISTRO'
        ? `[Cargill EHS - ${finding.location}] Nuevo Hallazgo Asignado (${finding.id} - ${finding.slaType})`
        : `[Cargill EHS - ${finding.location}] Cierre Confirmado de Hallazgo (${finding.id})`;

      const bodyLines = eventType === 'REGISTRO'
        ? [
            `Hola ${finding.ownerName},`,
            ``,
            `Se te ha asignado un nuevo hallazgo de seguridad en ${finding.location}:`,
            `- ID Hallazgo: ${finding.id}`,
            `- Localidad: ${finding.location}`,
            `- Área: ${finding.area}`,
            `- Salvador de Vida: ${finding.lifeSaver}`,
            `- Severidad / Plazo SLA: ${finding.slaType} (${finding.slaLabel})`,
            `- Fecha límite: ${new Date(finding.dueDate).toLocaleString('es-CO')}`,
            `- Descripción: ${finding.description}`,
            ``,
            `Atentamente,`,
            `Food Latam Caribe - Sistema EHS Cargill`
          ]
        : [
            `Hola ${finding.ownerName},`,
            ``,
            `Se ha registrado el cierre del siguiente hallazgo en ${finding.location}:`,
            `- ID Hallazgo: ${finding.id}`,
            `- Área: ${finding.area}`,
            `- Salvador de Vida: ${finding.lifeSaver}`,
            `- Fecha y Hora de Cierre: ${new Date(finding.closedAt).toLocaleString('es-CO')}`,
            `- Causa Raíz EHS: ${finding.rootCause}`,
            `- Acción Ejecutada: ${finding.closingComment}`,
            ``,
            `Atentamente,`,
            `Food Latam Caribe - Sistema EHS Cargill`
          ];

      // Envío opcional a webhook en la nube si está configurado
      if (CLOUD_CONFIG.webhookUrl) {
        fetch(CLOUD_CONFIG.webhookUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            eventType,
            to: finding.ownerEmail,
            subject,
            body: bodyLines.join('\n'),
            finding
          })
        }).catch(() => {});
      }

      // Apertura de cliente de correo dirigida ÚNICAMENTE al correo del responsable
      const mailtoUri = `mailto:${encodeURIComponent(finding.ownerEmail)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyLines.join('\n'))}`;
      const link = document.createElement('a');
      link.href = mailtoUri;
      link.style.display = 'none';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    /**
     * CÁLCULO DE ESTADO EFECTIVO (ABIERTO / VENCIDO / CERRADO) Y PLAZOS SLA
     */
    function getComputedStatus(finding) {
      if (finding.status === 'Cerrado') return 'Cerrado';
      return new Date() > new Date(finding.dueDate) ? 'Vencido' : 'Abierto';
    }

    function calculateDueDate(slaType) {
      const now = new Date();
      if (slaType === 'Tipo A') return new Date(now.getTime() + 24 * 3600 * 1000).toISOString();
      if (slaType === 'Tipo B') return new Date(now.getTime() + 15 * 86400 * 1000).toISOString();
      return new Date(now.getTime() + 30 * 86400 * 1000).toISOString();
    }

    function getSlaLabel(slaType) {
      if (slaType === 'Tipo A') return '24 horas';
      if (slaType === 'Tipo B') return '15 días';
      return '1 mes';
    }

