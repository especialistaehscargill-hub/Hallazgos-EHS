<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cargill | Food Latam EHS - Hallazgos de Planta</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <!-- Chart.js para analítica interactiva -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <!-- SheetJS para exportación a Excel (.xlsx) -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            cargill: {
              green: '#00843D',
              dark: '#005A2B',
              light: '#E6F4EC',
              mint: '#F2F9F5',
              accent: '#78BE20',
              gold: '#D99B26',
              slate: '#1E293B',
            }
          }
        }
      }
    };
  </script>

  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f4f7f5;
      color: #1e293b;
      overflow-x: hidden;
    }

    /* Animación continua de portada corporativa */
    @keyframes gradientShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    @keyframes pulseGlow {
      0%, 100% { transform: scale(1); opacity: 0.22; }
      50% { transform: scale(1.12); opacity: 0.36; }
    }

    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-6px); }
    }

    .cargill-hero-bg {
      background: linear-gradient(125deg, #004721, #007A33, #009A44, #005A2B);
      background-size: 300% 300%;
      animation: gradientShift 14s ease infinite;
    }

    .hero-orb {
      animation: pulseGlow 7s ease-in-out infinite;
    }

    .float-badge {
      animation: floatSlow 4.5s ease-in-out infinite;
    }

    /* Estilos de impresión para Reporte Gerencial PDF */
    @media print {
      body {
        background: #ffffff !important;
      }
      .no-print {
        display: none !important;
      }
      .print-only {
        display: block !important;
      }
      .print-card {
        box-shadow: none !important;
        border: 1px solid #cbd5e1 !important;
        break-inside: avoid;
      }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between antialiased">

  <!-- CONTENEDOR DE NOTIFICACIONES TOAST (SIN ALERT/CONFIRM) -->
  <div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none no-print"></div>

  <!-- ===================================================================== -->
  <!-- 1. PANTALLA DE INICIO DE SESIÓN OBLIGATORIA AL INGRESAR               -->
  <!-- ===================================================================== -->
  <section id="login-screen" class="min-h-screen flex flex-col justify-between cargill-hero-bg relative overflow-hidden">
    <!-- Elementos decorativos animados de fondo -->
    <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-emerald-300/20 blur-3xl hero-orb pointer-events-none"></div>
    <div class="absolute bottom-10 -right-24 w-96 h-96 rounded-full bg-lime-300/20 blur-3xl hero-orb pointer-events-none" style="animation-delay: 2s;"></div>

    <!-- Barra superior mínima del Login -->
    <header class="w-full max-w-6xl mx-auto px-4 sm:px-6 pt-6 flex items-center justify-between relative z-10">
      <div class="flex items-center gap-3">
        <!-- Logotipo Corporativo Cargill® SVG -->
        <div class="bg-white px-4 py-2 rounded-xl shadow-md flex items-center gap-1.5">
          <span class="text-2xl font-extrabold tracking-tight text-[#00843D]">Cargill</span>
          <span class="text-xs font-bold text-[#00843D] -mt-3">®</span>
          <span class="ml-1 inline-block w-2.5 h-2.5 rounded-full bg-[#78BE20]"></span>
        </div>
        <div class="hidden sm:block text-white">
          <p class="text-xs uppercase tracking-widest text-emerald-200 font-semibold">Seguridad Industrial &amp; Ambiente</p>
          <p class="text-sm font-bold">Food Latam EHS</p>
        </div>
      </div>
      <div class="flex items-center gap-2 bg-white/15 backdrop-blur-md border border-white/25 text-white px-3.5 py-1.5 rounded-full text-xs font-medium">
        <span class="w-2 h-2 rounded-full bg-lime-400 animate-pulse"></span>
        <span>Portal Operativo en Línea</span>
      </div>
    </header>

    <!-- Tarjeta Central de Inicio de Sesión -->
    <main class="flex-1 flex items-center justify-center px-4 py-8 relative z-10">
      <div class="w-full max-w-md bg-white rounded-3xl shadow-2xl border border-emerald-100 overflow-hidden">
        <!-- Encabezado de la tarjeta Login -->
        <div class="bg-gradient-to-r from-[#005A2B] to-[#00843D] px-6 py-6 text-white relative">
          <div class="flex items-center justify-between">
            <div>
              <span class="inline-block text-[11px] font-bold uppercase tracking-wider bg-white/20 px-2.5 py-0.5 rounded-full mb-2">
                Control de Acceso EHS
              </span>
              <h1 class="text-xl sm:text-2xl font-extrabold leading-tight">Hallazgos de Planta</h1>
              <p class="text-xs sm:text-sm text-emerald-100 mt-1">
                Inicia sesión seleccionando tu localidad operativa
              </p>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-white/15 border border-white/25 flex items-center justify-center shrink-0 float-badge">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
          </div>
        </div>

        <!-- Formulario de Inicio de Sesión -->
        <form id="login-form" class="p-6 sm:p-8 space-y-5" novalidate>
          <!-- Mensaje de error de autenticación -->
          <div id="login-error-box" class="hidden rounded-xl bg-red-50 border border-red-200 p-3.5 text-xs sm:text-sm text-red-700 flex items-start gap-2.5">
            <svg class="w-5 h-5 text-red-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
            </svg>
            <span id="login-error-text" class="font-medium"></span>
          </div>

          <!-- Campo Usuario -->
          <div>
            <label for="login-username" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
              Usuario <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 pointer-events-none">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </span>
              <input
                type="text"
                id="login-username"
                autocomplete="username"
                placeholder="Ej. Admin o usuario asignado"
                required
                class="w-full pl-11 pr-4 py-3 rounded-xl border border-slate-300 text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#00843D] focus:border-[#00843D] transition"
              />
            </div>
          </div>

          <!-- Campo Contraseña con botón ojito -->
          <div>
            <label for="login-password" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
              Contraseña <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 pointer-events-none">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </span>
              <input
                type="password"
                id="login-password"
                autocomplete="current-password"
                placeholder="••••••••••••"
                required
                class="w-full pl-11 pr-12 py-3 rounded-xl border border-slate-300 text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#00843D] focus:border-[#00843D] transition"
              />
              <button
                type="button"
                id="toggle-login-password"
                aria-label="Mostrar u ocultar contraseña"
                class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-[#00843D] focus:outline-none transition"
              >
                <!-- Ícono ojo abierto -->
                <svg id="eye-open-icon" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <!-- Ícono ojo tachado -->
                <svg id="eye-closed-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Campo Localidad Obligatorio -->
          <div>
            <label for="login-location" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
              Localidad Operativa <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 pointer-events-none">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </span>
              <select
                id="login-location"
                required
                class="w-full pl-11 pr-4 py-3 rounded-xl border border-slate-300 text-sm font-semibold text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-[#00843D] focus:border-[#00843D] transition"
              >
                <option value="">-- Seleccione la localidad --</option>
                <option value="Incubadora Mahates">Incubadora Mahates</option>
                <option value="Granjas Manantiales">Granjas Manantiales</option>
              </select>
            </div>
          </div>

          <!-- Botón Ingresar al Sistema -->
          <button
            type="submit"
            class="w-full py-3.5 px-5 rounded-xl bg-[#00843D] hover:bg-[#005A2B] active:scale-[0.99] text-white font-bold text-sm shadow-lg shadow-emerald-900/20 flex items-center justify-center gap-2 transition cursor-pointer"
          >
            <span>Ingresar al Sistema</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </button>

          <p class="text-[11px] text-center text-slate-400 pt-1">
            Acceso autorizado únicamente para personal EHS y operaciones de planta.
          </p>
        </form>
      </div>
    </main>

    <!-- Pie de página estricto en el Login -->
    <footer class="w-full py-4 text-center text-xs font-semibold tracking-wide text-emerald-100 relative z-10">
      Food Latam Caribe
    </footer>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. APLICACIÓN PRINCIPAL (OCULTA HASTA INICIAR SESIÓN)                 -->
  <!-- ===================================================================== -->
  <div id="app-shell" class="hidden min-h-screen flex flex-col justify-between">

    <!-- BARRA DE SESIÓN ACTIVA Y NAVEGACIÓN SUPERIOR -->
    <div class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm no-print">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-2.5 flex flex-wrap items-center justify-between gap-3">
        <!-- Identidad compacta -->
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-1 bg-[#00843D] text-white px-3 py-1.5 rounded-xl font-extrabold text-lg tracking-tight shadow-sm">
            <span>Cargill</span>
            <span class="text-[10px] -mt-2">®</span>
          </div>
          <div class="hidden md:block">
            <p class="text-xs font-bold text-slate-800 leading-none">Food Latam EHS</p>
            <p class="text-[11px] text-slate-500 mt-0.5">Gestión de Hallazgos de Planta</p>
          </div>
        </div>

        <!-- Indicadores de Usuario Activo, Rol, Localidad y Cerrar Sesión -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 ml-auto">
          <!-- Localidad Activa (o selector rápido si es Admin) -->
          <div class="flex items-center gap-1.5 bg-emerald-50 border border-emerald-200 text-[#005A2B] px-3 py-1.5 rounded-xl text-xs font-bold">
            <svg class="w-4 h-4 text-[#00843D] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span id="session-location-label">Incubadora Mahates</span>
            <!-- Selector rápido visible únicamente para Admin -->
            <select
              id="admin-location-switcher"
              title="Cambiar localidad activa (Vista Admin)"
              class="hidden ml-1 bg-white border border-emerald-300 rounded-lg px-2 py-0.5 text-[11px] font-bold text-[#005A2B] focus:outline-none focus:ring-1 focus:ring-[#00843D]"
            >
              <option value="Incubadora Mahates">Incubadora Mahates</option>
              <option value="Granjas Manantiales">Granjas Manantiales</option>
              <option value="Todas las Localidades">Todas las Localidades</option>
            </select>
          </div>

          <!-- Usuario y Rol -->
          <div class="flex items-center gap-2 bg-slate-100 border border-slate-200 px-3 py-1.5 rounded-xl text-xs">
            <div class="w-6 h-6 rounded-full bg-[#00843D] text-white font-bold flex items-center justify-center text-[11px]" id="session-avatar">
              A
            </div>
            <div class="leading-tight">
              <p class="font-bold text-slate-800" id="session-user-name">Admin</p>
              <p class="text-[10px] font-semibold uppercase tracking-wider text-[#00843D]" id="session-user-role">Administrador</p>
            </div>
          </div>

          <!-- Botón Cerrar Sesión -->
          <button
            type="button"
            id="btn-logout"
            class="px-3 py-1.5 rounded-xl bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 text-xs font-bold flex items-center gap-1.5 transition cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            <span>Cerrar Sesión</span>
          </button>
        </div>
      </div>

      <!-- PESTAÑAS DE NAVEGACIÓN PRINCIPAL -->
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center gap-1.5 overflow-x-auto pb-2 pt-1">
        <button
          type="button"
          data-tab="hallazgos"
          class="nav-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 transition whitespace-nowrap bg-[#00843D] text-white shadow-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
          </svg>
          <span>Gestión de Hallazgos</span>
        </button>

        <button
          type="button"
          data-tab="analitica"
          class="nav-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 transition whitespace-nowrap text-slate-600 hover:bg-slate-100"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z" />
          </svg>
          <span>Analítica Power BI</span>
        </button>

        <button
          type="button"
          data-tab="reporte"
          class="nav-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 transition whitespace-nowrap text-slate-600 hover:bg-slate-100"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Reporte Gerencial PDF</span>
        </button>

        <!-- PESTAÑA EXCLUSIVA PARA EL ADMINISTRADOR -->
        <button
          type="button"
          id="nav-tab-admin-users"
          data-tab="usuarios"
          class="nav-tab-btn hidden px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 transition whitespace-nowrap text-amber-800 bg-amber-50 hover:bg-amber-100 border border-amber-200"
        >
          <svg class="w-4 h-4 text-amber-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <span>Administración de Usuarios</span>
        </button>
      </nav>
    </div>

    <!-- BANNER CORPORATIVO ANIMADO CONTINUO -->
    <section class="cargill-hero-bg text-white relative overflow-hidden no-print">
      <div class="absolute -right-16 -top-16 w-72 h-72 rounded-full bg-lime-300/20 blur-2xl hero-orb pointer-events-none"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8 relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 bg-white/15 backdrop-blur-sm border border-white/25 px-3 py-1 rounded-full text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-lime-300 animate-ping"></span>
            <span>Sistema Corporativo EHS en Línea • Sin Modo Local</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
            Cargill | Food Latam EHS - Hallazgos de Planta
          </h1>
          <p class="text-xs sm:text-sm text-emerald-100 max-w-2xl">
            Inspección preventiva, control de SLA, los 12 Salvadores de Vida y trazabilidad visual de cierres para <strong class="text-white">Incubadora Mahates</strong> y <strong class="text-white">Granjas Manantiales</strong>.
          </p>
        </div>

        <!-- KPIs Rápidos en el Banner -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3 shrink-0">
          <div class="bg-white/15 backdrop-blur-md border border-white/20 rounded-2xl px-4 py-3 text-center">
            <p class="text-[11px] uppercase tracking-wider text-emerald-100 font-semibold">Total</p>
            <p id="kpi-total" class="text-2xl font-extrabold mt-0.5">0</p>
          </div>
          <div class="bg-white/15 backdrop-blur-md border border-white/20 rounded-2xl px-4 py-3 text-center">
            <p class="text-[11px] uppercase tracking-wider text-amber-200 font-semibold">Abiertos</p>
            <p id="kpi-abiertos" class="text-2xl font-extrabold text-amber-300 mt-0.5">0</p>
          </div>
          <div class="bg-white/15 backdrop-blur-md border border-white/20 rounded-2xl px-4 py-3 text-center">
            <p class="text-[11px] uppercase tracking-wider text-red-200 font-semibold">Vencidos</p>
            <p id="kpi-vencidos" class="text-2xl font-extrabold text-red-300 mt-0.5">0</p>
          </div>
          <div class="bg-white/15 backdrop-blur-md border border-white/20 rounded-2xl px-4 py-3 text-center">
