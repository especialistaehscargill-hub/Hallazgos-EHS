          <p class="text-xl font-extrabold text-amber-800">${abiertos}</p>
        </div>
        <div class="p-3.5 rounded-xl bg-red-50 border border-red-200">
          <p class="text-[11px] font-bold text-red-700 uppercase">Vencidos</p>
          <p class="text-xl font-extrabold text-red-800">${vencidos}</p>
        </div>
        <div class="p-3.5 rounded-xl bg-emerald-50 border border-emerald-200">
          <p class="text-[11px] font-bold text-emerald-700 uppercase">Cerrados</p>
          <p class="text-xl font-extrabold text-emerald-800">${cerrados}</p>
        </div>
      `;

      document.getElementById('report-table-body').innerHTML = scoped.map((f) => {
        const st = getComputedStatus(f);
        return `
          <tr>
            <td class="p-2.5 font-bold">${f.id}</td>
            <td class="p-2.5">${f.location}</td>
            <td class="p-2.5 font-semibold">${f.area}</td>
            <td class="p-2.5">${f.lifeSaver}</td>
            <td class="p-2.5">${f.slaType} (${f.slaLabel})</td>
            <td class="p-2.5">${f.ownerName}<br><span class="text-[10px] text-slate-500">${f.ownerEmail}</span></td>
            <td class="p-2.5 font-bold">${st}</td>
            <td class="p-2.5">${st === 'Cerrado' ? `${f.rootCause} — ${f.closingComment}` : 'Pendiente de cierre'}</td>
          </tr>
        `;
      }).join('');
    }

    /**
     * EXPORTACIÓN A EXCEL (.XLSX) CON SHEETJS
     */
    document.getElementById('btn-export-excel').addEventListener('click', () => {
      const scoped = getScopedFindings();
      if (scoped.length === 0) {
        showToast('No hay registros para exportar en esta vista.', 'info');
        return;
      }

      const rows = scoped.map((f) => ({
        'ID Hallazgo': f.id,
        'Localidad': f.location,
        'Área': f.area,
        'Salvador de Vida': f.lifeSaver,
        'Severidad SLA': `${f.slaType} (${f.slaLabel})`,
        'Descripción': f.description,
        'Responsable': f.ownerName,
        'Correo Responsable': f.ownerEmail,
        'Fecha Registro': new Date(f.createdAt).toLocaleString('es-CO'),
        'Fecha Límite': new Date(f.dueDate).toLocaleString('es-CO'),
        'Estado': getComputedStatus(f),
        'Fecha Cierre': f.closedAt ? new Date(f.closedAt).toLocaleString('es-CO') : '',
        'Causa Raíz EHS': f.rootCause || '',
        'Comentario Cierre': f.closingComment || ''
      }));

      const worksheet = XLSX.utils.json_to_sheet(rows);
      const workbook = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(workbook, worksheet, 'Hallazgos_EHS');
      XLSX.writeFile(workbook, `Cargill_FoodLatamCaribe_EHS_${new Date().toISOString().slice(0, 10)}.xlsx`);
      showToast('Archivo Excel (.xlsx) descargado correctamente.', 'success');
    });

    /**
     * ADMINISTRACIÓN DE USUARIOS (EXCLUSIVO ADMIN)
     */
    function renderUsersTable() {
      const tbody = document.getElementById('users-table-body');
      tbody.innerHTML = appState.users.map((u) => {
        const statusBadge =
          u.status === 'Activo'
            ? 'bg-emerald-100 text-emerald-800 border-emerald-200'
            : 'bg-red-100 text-red-700 border-red-200';

        return `
          <tr class="hover:bg-slate-50">
            <td class="p-3.5 font-semibold text-slate-800">
              ${u.fullName}
              ${u.isMaster ? '<span class="ml-1.5 text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full bg-amber-100 text-amber-800">Maestro</span>' : ''}
            </td>
            <td class="p-3.5 font-bold text-slate-900">${u.username}</td>
            <td class="p-3.5 font-mono text-xs text-slate-600">${u.password}</td>
            <td class="p-3.5 font-semibold text-[#005A2B]">${u.authorizedLocation}</td>
            <td class="p-3.5">
              <span class="px-2.5 py-1 rounded-full text-xs font-bold border ${statusBadge}">${u.status}</span>
            </td>
            <td class="p-3.5 text-right space-x-1.5 whitespace-nowrap">
              <button
                type="button"
                onclick="openEditUserModal('${u.id}')"
                class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs transition cursor-pointer"
              >
                Modificar
              </button>
              ${
                !u.isMaster
                  ? `<button
                      type="button"
                      onclick="deleteUserAccount('${u.id}')"
                      class="px-3 py-1.5 rounded-xl bg-red-50 hover:bg-red-100 text-red-700 font-bold text-xs transition cursor-pointer"
                    >
                      Eliminar
                    </button>`
                  : `<span class="inline-block px-2.5 py-1 text-[11px] font-semibold text-slate-400">Protegido</span>`
              }
            </td>
          </tr>
        `;
      }).join('');
    }

    document.getElementById('create-user-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const isAdmin = appState.currentUser && (appState.currentUser.username.toLowerCase() === 'admin' || appState.currentUser.role === 'Administrador');
      if (!isAdmin) return;

      const fullName = document.getElementById('new-user-fullname').value.trim();
      const username = document.getElementById('new-user-username').value.trim();
      const password = document.getElementById('new-user-password').value.trim();
      const authorizedLocation = document.getElementById('new-user-location').value;
      const status = document.getElementById('new-user-status').value;

      if (!fullName || !username || !password) {
        showToast('Completa Nombre, Usuario y Contraseña para crear la cuenta.', 'error');
        return;
      }

      const exists = appState.users.some((u) => u.username.toLowerCase() === username.toLowerCase());
      if (exists) {
        showToast(`El usuario "${username}" ya existe. Elige otro nombre de acceso.`, 'error');
        return;
      }

      appState.users.push({
        id: `usr-${Date.now()}`,
        fullName,
        username,
        password,
        role: 'Inspector',
        authorizedLocation,
        status,
        isMaster: false
      });

      document.getElementById('create-user-form').reset();
      renderUsersTable();
      showToast(`Usuario "${username}" creado para ${authorizedLocation}.`, 'success');
    });

    window.openEditUserModal = function (userId) {
      const user = appState.users.find((u) => u.id === userId);
      if (!user) return;

      document.getElementById('edit-user-id').value = user.id;
      document.getElementById('edit-user-fullname').value = user.fullName;
      document.getElementById('edit-user-username').value = user.username;
      document.getElementById('edit-user-password').value = user.password;
      document.getElementById('edit-user-location').value = user.authorizedLocation;
      document.getElementById('edit-user-status').value = user.status;

      // Proteger usuario maestro Admin contra bloqueo de acceso o cambio de usuario base
      document.getElementById('edit-user-username').disabled = !!user.isMaster;
      document.getElementById('edit-user-location-wrap').classList.toggle('hidden', !!user.isMaster);
      document.getElementById('edit-user-status-wrap').classList.toggle('hidden', !!user.isMaster);

      document.getElementById('edit-user-modal').classList.remove('hidden');
    };

    const closeEditUserModal = () => document.getElementById('edit-user-modal').classList.add('hidden');
    document.getElementById('btn-close-edit-user').addEventListener('click', closeEditUserModal);
    document.getElementById('btn-cancel-edit-user').addEventListener('click', closeEditUserModal);

    document.getElementById('edit-user-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const id = document.getElementById('edit-user-id').value;
      const user = appState.users.find((u) => u.id === id);
      if (!user) return;

      const newFullName = document.getElementById('edit-user-fullname').value.trim();
      const newUsername = document.getElementById('edit-user-username').value.trim();
      const newPassword = document.getElementById('edit-user-password').value.trim();

      if (!newFullName || !newUsername || !newPassword) {
        showToast('Todos los campos son obligatorios.', 'error');
        return;
      }

      const duplicate = appState.users.some((u) => u.id !== id && u.username.toLowerCase() === newUsername.toLowerCase());
      if (duplicate) {
        showToast(`Ya existe otro usuario con el identificador "${newUsername}".`, 'error');
        return;
      }

      user.fullName = newFullName;
      if (!user.isMaster) {
        user.username = newUsername;
        user.authorizedLocation = document.getElementById('edit-user-location').value;
        user.status = document.getElementById('edit-user-status').value;
      }
      user.password = newPassword;

      closeEditUserModal();
      renderUsersTable();
      showToast(`Credenciales de "${user.username}" actualizadas.`, 'success');
    });

    window.deleteUserAccount = function (userId) {
      const user = appState.users.find((u) => u.id === userId);
      if (!user || user.isMaster) return;
      appState.users = appState.users.filter((u) => u.id !== userId);
      renderUsersTable();
      showToast(`Usuario "${user.username}" eliminado del sistema.`, 'info');
    };

    /**
     * EVENTOS DE FILTRO Y RENDERIZADO GENERAL
     */
    ['filter-search', 'filter-status', 'filter-sla'].forEach((id) => {
      document.getElementById(id).addEventListener('input', renderFindingsList);
      document.getElementById(id).addEventListener('change', renderFindingsList);
    });

    function renderAllViews() {
      renderFindingsList();
      if (!document.getElementById('tab-analitica').classList.contains('hidden')) {
        renderAnalyticsCharts();
      }
      if (!document.getElementById('tab-reporte').classList.contains('hidden')) {
        renderManagerialReport();
      }
    }

    // Inicialización al cargar la ventana
    window.onload = function () {
      renderLifeSaversSelector();
      renderFindingsList();
    };
  </script>
</body>
</html>
