    /**
     * FILTRADO DE HALLAZGOS POR LOCALIDAD ACTIVA Y BÚSQUEDA
     */
    function getScopedFindings() {
      if (appState.activeLocation === 'Todas las Localidades') {
        return appState.findings;
      }
      return appState.findings.filter((f) => f.location === appState.activeLocation);
    }

    function updateKPIs() {
      const scoped = getScopedFindings();
      const total = scoped.length;
      const abiertos = scoped.filter((f) => getComputedStatus(f) === 'Abierto').length;
      const vencidos = scoped.filter((f) => getComputedStatus(f) === 'Vencido').length;
      const cerrados = scoped.filter((f) => getComputedStatus(f) === 'Cerrado').length;

      document.getElementById('kpi-total').textContent = total;
      document.getElementById('kpi-abiertos').textContent = abiertos;
      document.getElementById('kpi-vencidos').textContent = vencidos;
      document.getElementById('kpi-cerrados').textContent = cerrados;
    }

