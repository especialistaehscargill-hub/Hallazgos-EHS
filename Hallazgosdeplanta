      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="col-span-full bg-white rounded-2xl border border-slate-200 p-10 text-center space-y-2">
            <p class="text-sm font-bold text-slate-700">No hay hallazgos registrados para los filtros seleccionados.</p>
            <p class="text-xs text-slate-500">Pulsa "Registrar Hallazgo" para crear un nuevo reporte en ${appState.activeLocation}.</p>
