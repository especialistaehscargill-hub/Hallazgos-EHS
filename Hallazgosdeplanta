    /**
     * REGISTRO DE NUEVO HALLAZGO
     */
    document.getElementById('btn-open-new-finding').addEventListener('click', () => {
      document.getElementById('new-finding-card').classList.remove('hidden');
      syncLocationContextUI();
    });

    document.getElementById('btn-close-new-finding').addEventListener('click', () => {
      document.getElementById('new-finding-card').classList.add('hidden');
    });

    document.getElementById('btn-cancel-new-finding').addEventListener('click', () => {
      document.getElementById('new-finding-card').classList.add('hidden');
    });

    document.getElementById('finding-photo-input').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      appState.draftOpeningPhoto = await compressImageToDataUrl(file);
      const previewWrap = document.getElementById('opening-photo-preview-wrap');
      const previewImg = document.getElementById('opening-photo-preview');
      previewImg.src = appState.draftOpeningPhoto;
      previewWrap.classList.remove('hidden');
    });

    document.getElementById('finding-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const location = document.getElementById('finding-location').value;
      const area = document.getElementById('finding-area').value.trim();
      const slaType = document.getElementById('finding-sla').value;
      const lifeSaver = document.getElementById('finding-lifesaver').value;
      const description = document.getElementById('finding-description').value.trim();
      const ownerName = document.getElementById('finding-owner-name').value.trim();
      const ownerEmail = document.getElementById('finding-owner-email').value.trim();

      if (!area || !lifeSaver || !description || !ownerName || !ownerEmail) {
        showToast('Completa todos los campos obligatorios y selecciona un Salvador de Vida.', 'error');
        return;
      }

      const newId = `EHS-${100 + appState.findings.length + 1}`;
      const newFinding = {
        id: newId,
        location,
        area,
        slaType,
        slaLabel: getSlaLabel(slaType),
        lifeSaver,
        description,
        ownerName,
        ownerEmail,
        createdAt: new Date().toISOString(),
        dueDate: calculateDueDate(slaType),
        status: 'Abierto',
        openingPhoto: appState.draftOpeningPhoto || '',
        closingPhoto: '',
        closedAt: null,
        rootCause: '',
        closingComment: ''
      };

      appState.findings.unshift(newFinding);

      // Limpiar formulario
      document.getElementById('finding-form').reset();
      document.getElementById('finding-lifesaver').value = '';
      appState.draftOpeningPhoto = '';
      document.getElementById('opening-photo-preview-wrap').classList.add('hidden');
      document.querySelectorAll('.ls-option-btn').forEach((b) => {
        b.classList.remove('border-[#00843D]', 'bg-emerald-50', 'ring-2', 'ring-[#00843D]/30');
        b.classList.add('border-slate-200', 'bg-slate-50/70');
      });
      document.getElementById('new-finding-card').classList.add('hidden');

      renderAllViews();
      notifyResponsibleByEmail(newFinding, 'REGISTRO');
      showToast(`Hallazgo ${newId} registrado y notificado a ${ownerEmail}.`, 'success');
    });

    /**
     * CIERRE DE HALLAZGOS Y COMPARADOR ANTES VS DESPUÉS
     */
    window.openCloseFindingModal = function (findingId) {
      const finding = appState.findings.find((f) => f.id === findingId);
      if (!finding) return;

      appState.draftClosingPhoto = '';
      document.getElementById('close-finding-id').value = finding.id;
      document.getElementById('close-modal-subtitle').textContent = `${finding.id} • ${finding.area} (${finding.location})`;
      document.getElementById('close-comment').value = '';
      document.getElementById('close-photo-input').value = '';

      const beforeBox = document.getElementById('compare-before-box');
      beforeBox.innerHTML = finding.openingPhoto
        ? `<img src="${finding.openingPhoto}" alt="Antes" class="w-full h-full object-cover" />`
        : '<span>Sin foto de apertura</span>';

      document.getElementById('compare-after-box').innerHTML = '<span>Adjunte foto de cierre</span>';
      document.getElementById('close-finding-modal').classList.remove('hidden');
    };

    document.getElementById('close-photo-input').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      appState.draftClosingPhoto = await compressImageToDataUrl(file);
      document.getElementById('compare-after-box').innerHTML = `<img src="${appState.draftClosingPhoto}" alt="Después" class="w-full h-full object-cover" />`;
    });

    const hideCloseModal = () => document.getElementById('close-finding-modal').classList.add('hidden');
    document.getElementById('btn-dismiss-close-modal').addEventListener('click', hideCloseModal);
    document.getElementById('btn-cancel-close-modal').addEventListener('click', hideCloseModal);

    document.getElementById('close-finding-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const id = document.getElementById('close-finding-id').value;
      const rootCause = document.getElementById('close-root-cause').value;
      const closingComment = document.getElementById('close-comment').value.trim();

      const finding = appState.findings.find((f) => f.id === id);
      if (!finding || !closingComment) return;

      finding.status = 'Cerrado';
      finding.closedAt = new Date().toISOString();
      finding.rootCause = rootCause;
      finding.closingComment = closingComment;
      finding.closingPhoto = appState.draftClosingPhoto || '';

      hideCloseModal();
      renderAllViews();
      notifyResponsibleByEmail(finding, 'CIERRE');
      showToast(`Hallazgo ${finding.id} cerrado y confirmado a ${finding.ownerEmail}.`, 'success');
    });

    /**
     * ANALÍTICA INTERACTIVA (CHART.JS)
     */
    function renderAnalyticsCharts() {
      const scoped = getScopedFindings();

      // Destruir gráficos previos si existen
      Object.values(appState.charts).forEach((chart) => chart && chart.destroy());

      const abiertos = scoped.filter((f) => getComputedStatus(f) === 'Abierto').length;
      const vencidos = scoped.filter((f) => getComputedStatus(f) === 'Vencido').length;
      const cerrados = scoped.filter((f) => getComputedStatus(f) === 'Cerrado').length;

      appState.charts.status = new Chart(document.getElementById('chart-status'), {
        type: 'doughnut',
        data: {
          labels: ['Abiertos', 'Vencidos', 'Cerrados'],
          datasets: [{
            data: [abiertos, vencidos, cerrados],
            backgroundColor: ['#F59E0B', '#DC2626', '#00843D']
          }]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });

      const tipoA = scoped.filter((f) => f.slaType === 'Tipo A').length;
      const tipoB = scoped.filter((f) => f.slaType === 'Tipo B').length;
      const tipoC = scoped.filter((f) => f.slaType === 'Tipo C').length;

      appState.charts.sla = new Chart(document.getElementById('chart-sla'), {
        type: 'bar',
        data: {
          labels: ['Tipo A (24h)', 'Tipo B (15d)', 'Tipo C (1 mes)'],
          datasets: [{
            label: 'Cantidad',
            data: [tipoA, tipoB, tipoC],
            backgroundColor: ['#DC2626', '#D97706', '#0284C7'],
            borderRadius: 8
          }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
      });

      // Conteo por Salvadores de Vida
      const lsCounts = {};
      scoped.forEach((f) => {
        lsCounts[f.lifeSaver] = (lsCounts[f.lifeSaver] || 0) + 1;
      });
      appState.charts.lifesavers = new Chart(document.getElementById('chart-lifesavers'), {
        type: 'bar',
        data: {
          labels: Object.keys(lsCounts),
          datasets: [{
            label: 'Hallazgos',
            data: Object.values(lsCounts),
            backgroundColor: '#00843D',
            borderRadius: 6
          }]
        },
        options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
      });

      // Conteo por Área
      const areaCounts = {};
      scoped.forEach((f) => {
        areaCounts[f.area] = (areaCounts[f.area] || 0) + 1;
      });
      appState.charts.areas = new Chart(document.getElementById('chart-areas'), {
        type: 'bar',
        data: {
          labels: Object.keys(areaCounts),
          datasets: [{
            label: 'Hallazgos',
            data: Object.values(areaCounts),
            backgroundColor: '#78BE20',
            borderRadius: 6
          }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
      });
    }

