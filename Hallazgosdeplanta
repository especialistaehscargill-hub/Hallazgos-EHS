        formLocSelect.disabled = true;
      }
    }

    // Cerrar Sesión
    document.getElementById('btn-logout').addEventListener('click', () => {
      appState.currentUser = null;
      document.getElementById('app-shell').classList.add('hidden');
      document.getElementById('login-screen').classList.remove('hidden');
      document.getElementById('login-password').value = '';
      document.getElementById('login-error-box').classList.add('hidden');
      document.getElementById('new-finding-card').classList.add('hidden');
      showToast('Sesión cerrada correctamente.', 'info');
    });

    /**
     * NAVEGACIÓN ENTRE PESTAÑAS
     */
    function switchTab(tabKey) {
      // Bloqueo estricto de seguridad para pestaña de usuarios
      const isAdmin = appState.currentUser && (appState.currentUser.username.toLowerCase() === 'admin' || appState.currentUser.role === 'Administrador');
      if (tabKey === 'usuarios' && !isAdmin) {
        showToast('Acceso denegado: apartado exclusivo del Administrador.', 'error');
        return;
      }

      document.querySelectorAll('.tab-panel').forEach((panel) => panel.classList.add('hidden'));
      const targetPanel = document.getElementById(`tab-${tabKey}`);
      if (targetPanel) targetPanel.classList.remove('hidden');

      document.querySelectorAll('.nav-tab-btn').forEach((btn) => {
        const isCurrent = btn.dataset.tab === tabKey;
        if (btn.dataset.tab === 'usuarios') {
          btn.className = isCurrent
            ? 'nav-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 transition whitespace-nowrap bg-amber-600 text-white shadow-sm'
            : 'nav-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 transition whitespace-nowrap text-amber-800 bg-amber-50 hover:bg-amber-100 border border-amber-200';
        } else {
          btn.className = isCurrent
            ? 'nav-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 transition whitespace-nowrap bg-[#00843D] text-white shadow-sm'
            : 'nav-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 transition whitespace-nowrap text-slate-600 hover:bg-slate-100';
        }
      });

      if (tabKey === 'analitica') renderAnalyticsCharts();
      if (tabKey === 'reporte') renderManagerialReport();
      if (tabKey === 'usuarios' && isAdmin) renderUsersTable();
    }

    document.querySelectorAll('.nav-tab-btn').forEach((btn) => {
