      const passwordInput = document.getElementById('login-password').value;
      const selectedLocation = document.getElementById('login-location').value;
      const errorBox = document.getElementById('login-error-box');
      const errorText = document.getElementById('login-error-text');

      const showError = (msg) => {
        errorText.textContent = msg;
        errorBox.classList.remove('hidden');
      };

      errorBox.classList.add('hidden');

      if (!usernameInput || !passwordInput || !selectedLocation) {
        showError('Por favor completa Usuario, Contraseña y selecciona una Localidad.');
        return;
      }

      // Búsqueda de usuario (Admin insensible a mayúsculas/minúsculas o exacto 'Admin')
      const matchedUser = appState.users.find(
        (u) => u.username.toLowerCase() === usernameInput.toLowerCase() && u.password === passwordInput
      );

      if (!matchedUser) {
        showError('Usuario o contraseña incorrectos. Verifica tus credenciales.');
        return;
      }

      if (matchedUser.status !== 'Activo') {
        showError('Tu cuenta de usuario se encuentra Inactiva. Contacta al Administrador EHS.');
        return;
      }

      // Validación de permiso por localidad
      const isAdmin = matchedUser.username.toLowerCase() === 'admin' || matchedUser.role === 'Administrador';
      const hasLocationAccess =
        isAdmin ||
        matchedUser.authorizedLocation === 'Ambas Localidades' ||
        matchedUser.authorizedLocation === selectedLocation;

      if (!hasLocationAccess) {
        showError(`Tu usuario no tiene autorización para ingresar a "${selectedLocation}". Tu localidad asignada es "${matchedUser.authorizedLocation}".`);
        return;
      }

      // Inicio de sesión exitoso
      appState.currentUser = matchedUser;
      appState.activeLocation = selectedLocation;

      enterApplication();
    });

    function enterApplication() {
      const user = appState.currentUser;
      const isAdmin = user.username.toLowerCase() === 'admin' || user.role === 'Administrador';

      // Ocultar login y mostrar app
      document.getElementById('login-screen').classList.add('hidden');
      document.getElementById('app-shell').classList.remove('hidden');

      // Actualizar badges superiores
      document.getElementById('session-user-name').textContent = user.username;
      document.getElementById('session-user-role').textContent = isAdmin ? 'Administrador' : 'Inspector EHS';
      document.getElementById('session-avatar').textContent = user.username.charAt(0).toUpperCase();
      document.getElementById('session-location-label').textContent = appState.activeLocation;

      // Control de visibilidad exclusiva para Administrador
      const adminTabBtn = document.getElementById('nav-tab-admin-users');
      const adminLocSwitcher = document.getElementById('admin-location-switcher');

      if (isAdmin) {
        adminTabBtn.classList.remove('hidden');
        adminLocSwitcher.classList.remove('hidden');
        adminLocSwitcher.value = appState.activeLocation;
        renderUsersTable();
      } else {
        adminTabBtn.classList.add('hidden');
        adminLocSwitcher.classList.add('hidden');
      }

      syncLocationContextUI();
      switchTab('hallazgos');
      showToast(`Bienvenido, ${user.username} (${appState.activeLocation})`, 'success');
    }

    // Cambio rápido de localidad para Admin
    document.getElementById('admin-location-switcher').addEventListener('change', (e) => {
      const isAdmin = appState.currentUser && (appState.currentUser.username.toLowerCase() === 'admin' || appState.currentUser.role === 'Administrador');
      if (!isAdmin) return;
      appState.activeLocation = e.target.value;
      document.getElementById('session-location-label').textContent = appState.activeLocation;
      syncLocationContextUI();
      renderAllViews();
    });

    function syncLocationContextUI() {
      const loc = appState.activeLocation;
      const formLocSelect = document.getElementById('finding-location');
      const badge = document.getElementById('form-active-location-badge');
      const analyticsBadge = document.getElementById('analytics-scope-badge');

      badge.textContent = loc;
      analyticsBadge.textContent = `Vista activa: ${loc}`;

      if (loc === 'Todas las Localidades') {
        formLocSelect.disabled = false;
      } else {
