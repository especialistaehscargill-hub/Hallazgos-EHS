              ${
                status !== 'Cerrado'
                  ? `<button
                      type="button"
                      onclick="openCloseFindingModal('${f.id}')"
                      class="px-3.5 py-2 rounded-xl bg-[#00843D] hover:bg-[#005A2B] text-white font-bold text-xs shadow-sm transition cursor-pointer"
