        const computedStatus = getComputedStatus(f);
        const matchesSearch =
          !search ||
          f.area.toLowerCase().includes(search) ||
          f.ownerName.toLowerCase().includes(search) ||
          f.lifeSaver.toLowerCase().includes(search) ||
          f.description.toLowerCase().includes(search) ||
          f.id.toLowerCase().includes(search);
        const matchesStatus = statusFilter === 'TODOS' || computedStatus === statusFilter;
        const matchesSla = slaFilter === 'TODOS' || f.slaType === slaFilter;
        return matchesSearch && matchesStatus && matchesSla;
